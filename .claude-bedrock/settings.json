{
  "effortLevel": "medium",
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "qmd@qmd": true
  },
  "env": {
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "global.anthropic.claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "global.anthropic.claude-sonnet-5"
  },
  "extraKnownMarketplaces": {
    "qmd": {
      "source": {
        "repo": "tobi/qmd",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/context-budget.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/format-markdown.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/context-budget.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-new-directory.sh",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-question-legibility.sh",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/deny-subagent-git-write.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-task-scope.sh",
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-handoff-stale.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|clear"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/context-budget.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/context-budget.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-task-scope.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-task-scope.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude-bedrock/hooks/check-task-scope.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "language": "japanese",
  "model": "sonnet",
  "outputStyle": "Natural Japanese",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(curl:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(git push:*)",
      "Bash(wget:*)"
    ],
    "defaultMode": "plan",
    "deny": [
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(systemctl:*)",
      "Bash(launchctl:*)",
      "Bash(brew services:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude-bedrock/statusline.sh",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "useAutoModeDuringPlan": true
}
